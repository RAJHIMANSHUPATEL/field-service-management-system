generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPS
  TECHNICIAN
  CUSTOMER
}

enum AssetStatus {
  ACTIVE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  SUBMITTED
  NEEDS_INFO
  REJECTED
  ACCEPTED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  AWAITING_PARTS
  FOLLOW_UP_REQUIRED
  COMPLETED
}

enum VisitStatus {
  SCHEDULED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  UNSUCCESSFUL
  CANCELLED
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  customers    Customer[]
  assets       Asset[]
  serviceTypes    ServiceType[]
  technicians     Technician[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  serviceVisits   ServiceVisit[]
  workOrderNotes  WorkOrderNote[]
  auditEvents     AuditEvent[]
  invitations     Invitation[]
  skills          Skill[]
  serviceAreas    ServiceArea[]
  parts           Part[]
  warehouses      Warehouse[]
  visitPhotos     VisitPhoto[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  visitParts      VisitPart[]
  partRequests    PartRequest[]
  taxRatePercent  Decimal         @default(18) @db.Decimal(5, 2)
  paymentTermsDays Int            @default(15)
  invoiceSequence Int             @default(0)
  contracts       ServiceContract[]
  invoices        Invoice[]
  invoiceLines    InvoiceLine[]
  payments        Payment[]
  feedback        Feedback[]
  notificationRules NotificationRule[]
  notifications   Notification[]
}

model User {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  passwordHash    String
  name            String
  role            Role
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id])
  refreshTokens   RefreshToken[]
  customerContact     CustomerContact?
  technician          Technician?
  serviceRequestNotes ServiceRequestNote[]
  workOrderNotes      WorkOrderNote[]
  auditEvents         AuditEvent[]
  visitChanges        VisitChange[]
  requestAttachments  ServiceRequestAttachment[]
  visitPhotos         VisitPhoto[]
  stockMovements      StockMovement[]
  partRequests        PartRequest[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]
  paymentsRecorded    Payment[]
  notifications       Notification[]
  feedbackGiven       Feedback[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

model Customer {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  contacts        CustomerContact[]
  addresses       Address[]
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  contracts       ServiceContract[]
  invoices        Invoice[]

  @@index([organizationId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String
  phone      String?
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  serviceRequests ServiceRequest[]

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([customerId])
}

model Asset {
  id                String         @id @default(cuid())
  organizationId    String
  customerId        String
  addressId         String
  equipmentType     String
  model             String
  serialNumber      String
  installedAt       DateTime?
  warrantyExpiresAt DateTime?
  status            AssetStatus    @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id])
  customer          Customer         @relation(fields: [customerId], references: [id])
  address           Address          @relation(fields: [addressId], references: [id])
  serviceRequests   ServiceRequest[]
  workOrders        WorkOrder[]
  contractAssets    ContractAsset[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([addressId])
}

model ServiceType {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  requiredSkillId String?
  organization    Organization     @relation(fields: [organizationId], references: [id])
  requiredSkill   Skill?           @relation(fields: [requiredSkillId], references: [id])
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  serviceCharge     Decimal      @default(0) @db.Decimal(12, 2)
  labourRatePerHour Decimal      @default(0) @db.Decimal(12, 2)
  sacCode           String?

  @@index([requiredSkillId])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Technician {
  id             String      @id @default(cuid())
  organizationId String
  userId         String      @unique
  phone          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  workOrders     WorkOrder[]
  serviceVisits  ServiceVisit[]
  skills         TechnicianSkill[]
  serviceAreas   TechnicianServiceArea[]
  van            Warehouse?
  timeOff        TechnicianTimeOff[]

  @@index([organizationId])
}

model ServiceRequest {
  id              String               @id @default(cuid())
  organizationId  String
  customerId      String
  contactId       String?
  assetId         String
  addressId       String
  serviceTypeId   String
  description     String
  preferredStart  DateTime             @db.Date
  preferredEnd    DateTime             @db.Date
  priority        RequestPriority      @default(NORMAL)
  status          ServiceRequestStatus @default(SUBMITTED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  contact         CustomerContact?     @relation(fields: [contactId], references: [id])
  asset           Asset                @relation(fields: [assetId], references: [id])
  address         Address              @relation(fields: [addressId], references: [id])
  serviceType     ServiceType          @relation(fields: [serviceTypeId], references: [id])
  notes           ServiceRequestNote[]
  attachments     ServiceRequestAttachment[]
  workOrder       WorkOrder?

  @@index([organizationId])
  @@index([customerId])
  @@index([contactId])
  @@index([status])
  @@index([assetId])
  @@index([addressId])
  @@index([serviceTypeId])
}

model ServiceRequestNote {
  id        String         @id @default(cuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  author    User           @relation(fields: [authorId], references: [id])

  @@index([requestId])
  @@index([authorId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  requestId      String          @unique
  customerId     String
  assetId        String
  addressId      String
  serviceTypeId  String
  technicianId   String?
  priority       RequestPriority
  description    String
  status         WorkOrderStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  request        ServiceRequest  @relation(fields: [requestId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  asset          Asset           @relation(fields: [assetId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  serviceType    ServiceType     @relation(fields: [serviceTypeId], references: [id])
  technician     Technician?     @relation(fields: [technicianId], references: [id])
  visits         ServiceVisit[]
  partRequests   PartRequest[]
  notes          WorkOrderNote[]
  invoice        Invoice?
  feedback       Feedback?

  @@index([organizationId])
  @@index([customerId])
  @@index([assetId])
  @@index([addressId])
  @@index([serviceTypeId])
  @@index([technicianId])
  @@index([status])
}

model ServiceVisit {
  id             String      @id @default(cuid())
  organizationId String
  workOrderId    String
  technicianId   String
  scheduledStart DateTime
  durationMinutes Int        @default(120)
  status         VisitStatus @default(SCHEDULED)
  enRouteAt      DateTime?
  arrivedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  endedAt        DateTime?
  outcomeReason  String?
  diagnosis      String?
  workPerformed  String?
  signerName     String?
  signatureKey   String?
  signedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id])
  technician     Technician   @relation(fields: [technicianId], references: [id])
  changes        VisitChange[]
  photos         VisitPhoto[]
  parts          VisitPart[]

  @@index([scheduledStart])
  @@index([organizationId])
  @@index([workOrderId])
  @@index([technicianId])
  @@index([status])
}

model WorkOrderNote {
  id             String       @id @default(cuid())
  organizationId String
  workOrderId    String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id])
  author         User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([workOrderId])
  @@index([authorId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  method         String
  path           String
  status         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedById    String
  email          String
  name           String
  role           Role
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  invitedBy      User             @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
}

model Skill {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  technicians    TechnicianSkill[]
  serviceTypes   ServiceType[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TechnicianSkill {
  id           String     @id @default(cuid())
  technicianId String
  skillId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id])

  @@unique([technicianId, skillId])
  @@index([technicianId])
  @@index([skillId])
}

model ServiceArea {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  postalCodes    String[]
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id])
  technicians    TechnicianServiceArea[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TechnicianServiceArea {
  id            String      @id @default(cuid())
  technicianId  String
  serviceAreaId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  technician    Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id])

  @@unique([technicianId, serviceAreaId])
  @@index([technicianId])
  @@index([serviceAreaId])
}

model Part {
  id             String       @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  unitPrice      Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  isSerialized   Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  visitParts     VisitPart[]
  requests       PartRequest[]
  reorderLevel   Int          @default(0)

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum WarehouseKind {
  WAREHOUSE
  VAN
}

model Warehouse {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  kind           WarehouseKind @default(WAREHOUSE)
  technicianId   String?       @unique
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  technician     Technician?   @relation(fields: [technicianId], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  visitParts     VisitPart[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ServiceRequestAttachment {
  id             String         @id @default(cuid())
  organizationId String
  requestId      String
  uploadedById   String
  fileName       String
  contentType    String
  size           Int
  storageKey     String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  request        ServiceRequest @relation(fields: [requestId], references: [id])
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([requestId])
  @@index([uploadedById])
}

enum VisitChangeKind {
  SCHEDULED
  RESCHEDULED
  REASSIGNED
  CANCELLED
}

// History of how a visit was planned. One row per change, never edited.
model VisitChange {
  id               String          @id @default(cuid())
  organizationId   String
  visitId          String
  actorId          String
  kind             VisitChangeKind
  fromStart        DateTime?
  toStart          DateTime?
  fromTechnicianId String?
  toTechnicianId   String?
  reason           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  visit            ServiceVisit    @relation(fields: [visitId], references: [id])
  actor            User            @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([visitId])
  @@index([actorId])
}

model TechnicianTimeOff {
  id             String     @id @default(cuid())
  organizationId String
  technicianId   String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  technician     Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([technicianId])
  @@index([startsAt])
}

model VisitPhoto {
  id             String       @id @default(cuid())
  organizationId String
  visitId        String
  uploadedById   String
  fileName       String
  contentType    String
  size           Int
  storageKey     String
  caption        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  visit          ServiceVisit @relation(fields: [visitId], references: [id])
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([visitId])
}

// On-hand and reserved quantity of one part at one location. Available = onHand - reserved.
model StockLevel {
  id             String       @id @default(cuid())
  organizationId String
  warehouseId    String
  partId         String
  onHand         Int          @default(0)
  reserved       Int          @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  part           Part         @relation(fields: [partId], references: [id])

  @@unique([warehouseId, partId])
  @@index([organizationId])
}

enum StockMovementKind {
  RECEIVED
  TRANSFER_OUT
  TRANSFER_IN
  RESERVED
  RELEASED
  CONSUMED
  RETURNED
  ADJUSTED
}

// Append-only ledger. onHandDelta and reservedDelta are what the row did to the StockLevel.
model StockMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  warehouseId        String
  partId             String
  kind               StockMovementKind
  onHandDelta        Int
  reservedDelta      Int               @default(0)
  reason             String
  actorId            String
  visitId            String?
  visitPartId        String?
  transferGroup      String?
  createdAt          DateTime          @default(now())
  organization       Organization      @relation(fields: [organizationId], references: [id])
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id])
  part               Part              @relation(fields: [partId], references: [id])
  actor              User              @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([warehouseId, partId])
  @@index([visitId])
}

enum VisitPartStatus {
  RESERVED
  CONSUMED
  RELEASED
  RETURNED
}

// A part planned for or used on a visit, priced at the catalogue price when added.
model VisitPart {
  id             String          @id @default(cuid())
  organizationId String
  visitId        String
  partId         String
  warehouseId    String
  quantity       Int
  status         VisitPartStatus @default(RESERVED)
  unitPrice      Decimal         @db.Decimal(12, 2)
  currency       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  visit          ServiceVisit    @relation(fields: [visitId], references: [id])
  part           Part            @relation(fields: [partId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@index([visitId])
}

enum PartRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

// A part the technician needs for a follow-up visit that was not in stock.
model PartRequest {
  id             String            @id @default(cuid())
  organizationId String
  workOrderId    String
  visitId        String?
  partId         String
  quantity       Int
  status         PartRequestStatus @default(OPEN)
  note           String?
  requestedById  String
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder         @relation(fields: [workOrderId], references: [id])
  part           Part              @relation(fields: [partId], references: [id])
  requestedBy    User              @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status])
  @@index([workOrderId])
}

enum ContractStatus {
  ACTIVE
  CANCELLED
}

// An AMC or service contract. Coverage percentages apply to the matching invoice lines of a job
// on a covered asset completed while the contract is active.
model ServiceContract {
  id                          String         @id @default(cuid())
  organizationId              String
  customerId                  String
  name                        String
  startsOn                    DateTime
  endsOn                      DateTime
  status                      ContractStatus @default(ACTIVE)
  serviceChargeCoveredPercent Int            @default(100)
  labourCoveredPercent        Int            @default(100)
  partsCoveredPercent         Int            @default(0)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  organization                Organization   @relation(fields: [organizationId], references: [id])
  customer                    Customer       @relation(fields: [customerId], references: [id])
  assets                      ContractAsset[]
  invoices                    Invoice[]

  @@index([organizationId])
  @@index([customerId])
}

model ContractAsset {
  id         String          @id @default(cuid())
  contractId String
  assetId    String
  contract   ServiceContract @relation(fields: [contractId], references: [id])
  asset      Asset           @relation(fields: [assetId], references: [id])

  @@unique([contractId, assetId])
  @@index([assetId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  OVERDUE
  PAID
  VOID
}

enum CoverageSource {
  NONE
  WARRANTY
  CONTRACT
}

model Invoice {
  id              String         @id @default(cuid())
  organizationId  String
  workOrderId     String         @unique
  customerId      String
  number          String?
  status          InvoiceStatus  @default(DRAFT)
  currency        String         @default("INR")
  subtotal        Decimal        @db.Decimal(12, 2)
  coveredTotal    Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal        @db.Decimal(12, 2)
  taxRatePercent  Decimal        @db.Decimal(5, 2)
  cgst            Decimal        @db.Decimal(12, 2)
  sgst            Decimal        @db.Decimal(12, 2)
  taxTotal        Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  amountPaid      Decimal        @default(0) @db.Decimal(12, 2)
  coverageSource  CoverageSource @default(NONE)
  contractId      String?
  notes           String?
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id])
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  contract        ServiceContract? @relation(fields: [contractId], references: [id])
  lines           InvoiceLine[]
  payments        Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
}

enum InvoiceLineKind {
  SERVICE_CHARGE
  LABOUR
  PART
  ADDITIONAL
}

model InvoiceLine {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String
  kind           InvoiceLineKind
  description    String
  quantity       Decimal         @db.Decimal(10, 2)
  unitPrice      Decimal         @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  coveredAmount  Decimal         @default(0) @db.Decimal(12, 2)
  sacCode        String?
  visitPartId    String?
  position       Int
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoice        Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  provider       String?
  paidAt         DateTime
  recordedById   String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  recordedBy     User          @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([organizationId])
}

// The customer's rating after a completed job, one per work order.
model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  workOrderId    String       @unique
  authorId       String
  rating         Int
  satisfied      Boolean
  comment        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id])
  author         User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, createdAt])
}

enum NotificationAudience {
  CUSTOMER
  TECHNICIAN
  OPS
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Table-driven rules: which channels an event uses for its audience, and the wording.
model NotificationRule {
  id             String               @id @default(cuid())
  organizationId String
  event          String
  audience       NotificationAudience
  channels       NotificationChannel[]
  subject        String
  body           String
  isEnabled      Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, event])
}

// One delivery of one event to one recipient on one channel; the worker sends it with retry.
model Notification {
  id             String              @id @default(cuid())
  organizationId String
  event          String
  audience       NotificationAudience
  channel        NotificationChannel
  recipientId    String
  subject        String
  body           String
  link           String?
  entityType     String?
  entityId       String?
  dedupeKey      String?
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id])
  recipient      User                @relation(fields: [recipientId], references: [id])

  @@unique([organizationId, dedupeKey, recipientId, channel])
  @@index([organizationId, event])
  @@index([recipientId, channel, readAt])
  @@index([status])
}
