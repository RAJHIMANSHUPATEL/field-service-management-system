generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPS
  TECHNICIAN
  CUSTOMER
}

enum AssetStatus {
  ACTIVE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  SUBMITTED
  NEEDS_INFO
  REJECTED
  ACCEPTED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
}

enum VisitStatus {
  SCHEDULED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  CANCELLED
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  customers    Customer[]
  assets       Asset[]
  serviceTypes    ServiceType[]
  technicians     Technician[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  serviceVisits   ServiceVisit[]
  workOrderNotes  WorkOrderNote[]
  auditEvents     AuditEvent[]
  invitations     Invitation[]
  skills          Skill[]
  serviceAreas    ServiceArea[]
  parts           Part[]
  warehouses      Warehouse[]
}

model User {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  passwordHash    String
  name            String
  role            Role
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id])
  refreshTokens   RefreshToken[]
  customerContact     CustomerContact?
  technician          Technician?
  serviceRequestNotes ServiceRequestNote[]
  workOrderNotes      WorkOrderNote[]
  auditEvents         AuditEvent[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

model Customer {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  contacts        CustomerContact[]
  addresses       Address[]
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([organizationId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String
  phone      String?
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  serviceRequests ServiceRequest[]

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id])
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([customerId])
}

model Asset {
  id                String         @id @default(cuid())
  organizationId    String
  customerId        String
  addressId         String
  equipmentType     String
  model             String
  serialNumber      String
  installedAt       DateTime?
  warrantyExpiresAt DateTime?
  status            AssetStatus    @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id])
  customer          Customer         @relation(fields: [customerId], references: [id])
  address           Address          @relation(fields: [addressId], references: [id])
  serviceRequests   ServiceRequest[]
  workOrders        WorkOrder[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([addressId])
}

model ServiceType {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id])
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Technician {
  id             String      @id @default(cuid())
  organizationId String
  userId         String      @unique
  phone          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  workOrders     WorkOrder[]
  serviceVisits  ServiceVisit[]
  skills         TechnicianSkill[]
  serviceAreas   TechnicianServiceArea[]
  van            Warehouse?

  @@index([organizationId])
}

model ServiceRequest {
  id              String               @id @default(cuid())
  organizationId  String
  customerId      String
  contactId       String?
  assetId         String
  addressId       String
  serviceTypeId   String
  description     String
  preferredStart  DateTime             @db.Date
  preferredEnd    DateTime             @db.Date
  priority        RequestPriority      @default(NORMAL)
  status          ServiceRequestStatus @default(SUBMITTED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  contact         CustomerContact?     @relation(fields: [contactId], references: [id])
  asset           Asset                @relation(fields: [assetId], references: [id])
  address         Address              @relation(fields: [addressId], references: [id])
  serviceType     ServiceType          @relation(fields: [serviceTypeId], references: [id])
  notes           ServiceRequestNote[]
  workOrder       WorkOrder?

  @@index([organizationId])
  @@index([customerId])
  @@index([contactId])
  @@index([status])
  @@index([assetId])
  @@index([addressId])
  @@index([serviceTypeId])
}

model ServiceRequestNote {
  id        String         @id @default(cuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  author    User           @relation(fields: [authorId], references: [id])

  @@index([requestId])
  @@index([authorId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  requestId      String          @unique
  customerId     String
  assetId        String
  addressId      String
  serviceTypeId  String
  technicianId   String?
  priority       RequestPriority
  description    String
  status         WorkOrderStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  request        ServiceRequest  @relation(fields: [requestId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  asset          Asset           @relation(fields: [assetId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  serviceType    ServiceType     @relation(fields: [serviceTypeId], references: [id])
  technician     Technician?     @relation(fields: [technicianId], references: [id])
  visits         ServiceVisit[]
  notes          WorkOrderNote[]

  @@index([organizationId])
  @@index([customerId])
  @@index([assetId])
  @@index([addressId])
  @@index([serviceTypeId])
  @@index([technicianId])
  @@index([status])
}

model ServiceVisit {
  id             String      @id @default(cuid())
  organizationId String
  workOrderId    String
  technicianId   String
  scheduledStart DateTime
  status         VisitStatus @default(SCHEDULED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id])
  technician     Technician   @relation(fields: [technicianId], references: [id])

  @@index([organizationId])
  @@index([workOrderId])
  @@index([technicianId])
  @@index([status])
}

model WorkOrderNote {
  id             String       @id @default(cuid())
  organizationId String
  workOrderId    String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id])
  author         User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([workOrderId])
  @@index([authorId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  method         String
  path           String
  status         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedById    String
  email          String
  name           String
  role           Role
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  invitedBy      User             @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
}

model Skill {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  technicians    TechnicianSkill[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TechnicianSkill {
  id           String     @id @default(cuid())
  technicianId String
  skillId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id])

  @@unique([technicianId, skillId])
  @@index([technicianId])
  @@index([skillId])
}

model ServiceArea {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  postalCodes    String[]
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id])
  technicians    TechnicianServiceArea[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TechnicianServiceArea {
  id            String      @id @default(cuid())
  technicianId  String
  serviceAreaId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  technician    Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id])

  @@unique([technicianId, serviceAreaId])
  @@index([technicianId])
  @@index([serviceAreaId])
}

model Part {
  id             String       @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  unitPrice      Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  isSerialized   Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum WarehouseKind {
  WAREHOUSE
  VAN
}

model Warehouse {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  kind           WarehouseKind @default(WAREHOUSE)
  technicianId   String?       @unique
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  technician     Technician?   @relation(fields: [technicianId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}
