# Use the password for your local PostgreSQL superuser (URL-encode special characters).
DATABASE_URL="postgresql://postgres:<your-postgres-password>@localhost:5432/field_service?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
# Also keys the sealed successor kept during the refresh grace window. Optional window override (ms, 0-60000, default 10000):
# REFRESH_GRACE_WINDOW_MS=10000
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# Mail: "log" (default) prints messages, "file" also appends them to MAIL_OUTBOX_FILE,
# "smtp" sends them through the SMTP server below (nodemailer).
MAIL_PROVIDER="log"
MAIL_OUTBOX_FILE=".mail/outbox.jsonl"
# SMTP (only read when MAIL_PROVIDER="smtp"). If any of HOST/PORT/USER/PASS is missing, mail is
# logged instead (one warning at the first message, naming the missing variables, never values).
# A failed send is retried by the notification worker (5 attempts, then FAILED).
# SMTP_HOST="smtp.your-provider.example"
# SMTP_PORT=587                      # a number; 465 = TLS from the start, 587/25 = STARTTLS
# SMTP_USER="<smtp-username>"
# SMTP_PASS="<smtp-password>"
# SMTP_SECURE=false                  # optional; true/false overrides the default (true only on port 465)
# MAIL_FROM="FieldOps <no-reply@example.com>"   # optional; this is the default sender
APP_URL="http://localhost:5173"
# Object storage (MinIO from docker-compose, or any S3-compatible endpoint).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="field-service"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Background jobs (BullMQ). NOTIFICATION_QUEUE=inline delivers in-process (tests).
REDIS_URL=redis://localhost:6379
NOTIFICATION_QUEUE=bullmq
SMS_PROVIDER=log
# How often due maintenance plans are checked (ms).
MAINTENANCE_SWEEP_MS=900000

# Phase 12 hardening. 0 disables a limiter (the default under NODE_ENV=test).
RATE_LIMIT_AUTH=10        # login/refresh/reset attempts per minute per IP+email
RATE_LIMIT_API=600        # API requests per minute per IP
RATE_LIMIT_STORE=redis    # redis or memory
TRUST_PROXY=false         # set to the hop count (e.g. 1) behind a reverse proxy
