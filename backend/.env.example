# Use the password for your local PostgreSQL superuser.
DATABASE_URL="postgresql://postgres:P0$tP@s$wDkWKw_1One1@localhost:5432/field_service?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
# Also keys the sealed successor kept during the refresh grace window. Optional window override (ms, 0-60000, default 10000):
# REFRESH_GRACE_WINDOW_MS=10000
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# Mail stays local: "log" prints messages, "file" also appends them to MAIL_OUTBOX_FILE.
MAIL_PROVIDER="log"
MAIL_OUTBOX_FILE=".mail/outbox.jsonl"
APP_URL="http://localhost:5173"
# Object storage (MinIO from docker-compose, or any S3-compatible endpoint).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="field-service"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Background jobs (BullMQ). NOTIFICATION_QUEUE=inline delivers in-process (tests).
REDIS_URL=redis://localhost:6379
NOTIFICATION_QUEUE=bullmq
SMS_PROVIDER=log
# How often due maintenance plans are checked (ms).
MAINTENANCE_SWEEP_MS=900000

# Phase 12 hardening. 0 disables a limiter (the default under NODE_ENV=test).
RATE_LIMIT_AUTH=10        # login/refresh/reset attempts per minute per IP+email
RATE_LIMIT_API=600        # API requests per minute per IP
RATE_LIMIT_STORE=redis    # redis or memory
TRUST_PROXY=false         # set to the hop count (e.g. 1) behind a reverse proxy
